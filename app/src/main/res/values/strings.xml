    <string name="reset_title">Reset review history?</string>
    <string name="reset_body">Photos you kept will appear in cleanup sessions again, and open sessions start fresh. No photos are deleted or changed. Your review queue, today\'s review count and Premium stay as they are.</string>
    <string name="reset_confirm">Reset history</string>
    <string name="reset_done">Review history reset. Your photos and queue were not changed.</string>
    <string name="privacy_title">Privacy</string>
    <string name="privacy_device_title">On this device</string>
    <string name="privacy_device_body">Swipe Gallery works entirely on your phone. It has no account, no servers, no analytics and no ads. Photos, thumbnails, file names and review history are never uploaded, and review history is excluded from device backups.</string>
    <string name="privacy_access_title">Photo access</string>
    <string name="privacy_access_body">The app reads photos through Android\'s media library to show them for review. On Android 14 and later you can share only selected photos; the app then works with just those.</string>
    <string name="privacy_removal_title">Removing photos</string>
    <string name="privacy_removal_body">Swiping left only adds a photo to your review queue. Photos move to the device trash only after you confirm in Android\'s own dialog. The app never deletes permanently, and it can\'t remove copies stored in cloud backups.</string>
    <string name="privacy_purchases_title">Purchases</string>
    <string name="privacy_purchases_body">Premium is sold through Google Play. The app checks your purchase with Google Play on this device; it doesn\'t see your payment details.</string>
    <string name="privacy_limits_title">Daily limit</string>
    <string name="privacy_limits_body">The 50 free reviews a day are counted on this device using its clock and calendar.</string>
    <string name="privacy_font_licenses">Font licenses</string>
    <string name="privacy_font_licenses_sub">Instrument Serif and Inter, SIL Open Font License 1.1</string>

